# Copy this file to .env and fill in the values you have.
# Anything left blank is skipped gracefully (see README).

# --- LLM: Gemini is tried first, Groq is the fallback ---
GEMINI_API_KEY=
# Alias that tracks Google's current Flash model. Check the exact IDs in Google AI Studio.
GEMINI_MODEL=gemini-flash-latest
# Tried next when the main model is overloaded (503). Leave blank to go straight to Groq.
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

GROQ_API_KEY=
# Production model on Groq as of Oct 2026. See console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

LLM_TEMPERATURE=0.1
# Per-call limit; on timeout the next model is tried.
LLM_TIMEOUT_SECONDS=30

# --- Qdrant (unstructured docs) ---
# Leave QDRANT_URL blank to use an embedded local store in ./storage/qdrant (no account needed).
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=aml_docs

# --- Retrieval ---
DENSE_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K=6

# --- Neo4j (phase 2: transactions graph) ---
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Upper limit for scripts.generate_data --transactions (keeps AuraDB Free well under its limits)
MAX_TRANSACTIONS=50000

# --- Phase 4: outside services (each one is optional) ---
# Tavily web search, used through Tavily's hosted MCP server. Free: 1,000 credits/month.
TAVILY_API_KEY=
# Google Calendar: OAuth client file (Desktop app) from Google Cloud Console.
# Run `python -m scripts.google_auth` once to sign in; the token is saved to GOOGLE_TOKEN_FILE.
GOOGLE_CLIENT_SECRET_FILE=secrets/google_client_secret.json
GOOGLE_TOKEN_FILE=secrets/google_token.json
# Slack bot token (xoxb-...) and the channel ID escalations go to by default (e.g. C0123ABCD).
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=
# Proposed Slack posts and calendar events expire if nobody approves them in time.
APPROVAL_TTL_MINUTES=30

# --- App ---
API_URL=http://localhost:8000
